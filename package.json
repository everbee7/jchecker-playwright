{
  "name": "jobchecker",
  "productName": "JobChecker",
  "version": "1.0.0",
  "description": "Desktop job-link analysis and technology matching dashboard",
  "author": "JobChecker contributors",
  "private": true,
  "main": "desktop-dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "desktop:clean": "node -e \"require('node:fs').rmSync('desktop-dist',{recursive:true,force:true})\"",
    "desktop:compile": "npm run desktop:clean && tsc -p tsconfig.electron.json",
    "desktop:browsers": "node desktop/install-playwright-browsers.mjs",
    "desktop:run": "npm run build && npm run desktop:compile && electron .",
    "desktop:build": "npm run desktop:browsers && npm run build && npm run desktop:compile && electron-builder --win portable"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.12.0",
    "next": "^15.1.3",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.13.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "electron@43.1.1": true
  },
  "packageManager": "yarn@4.3.1+sha512.af78262d7d125afbfeed740602ace8c5e4405cd7f4735c08feb327286b2fdb2390fbca01589bfd1f50b1240548b74806767f5a063c94b67e431aabd0d86f7774"
}
